-- WindUI → Mario Hub Shim
-- Dipakai sebagai layer terpisah, bukan di dalam ui_v2.lua
return function(MarioLib)
    local Shim = {}
    
    local IconMap = {
        ["lucide:shield"] = "shield",
        ["lucide:crosshair"] = "crosshair",
        ["lucide:sword"] = "sword",
        ["lucide:gamepad-directional"] = "gamepad",
        ["lucide:keyboard"] = "keyboard",
        ["lucide:sparkles"] = "highlight",
        ["lucide:flame"] = "fire",
        ["lucide:zap"] = "lightning",
        ["lucide:navigation"] = "teleport",
        ["lucide:arrow-right-left"] = "hop",
        ["lucide:users"] = "players",
        ["lucide:folder-open"] = "folder",
        ["lucide:save"] = "save",
        ["lucide:trash"] = "trash",
        ["lucide:trash-2"] = "trash",
        ["solar:planet-bold"] = "main",
        ["solar:eye-bold"] = "eye",
        ["solar:bolt-bold"] = "lightning",
        ["solar:dollar-minimalistic-bold"] = "coin",
        ["solar:user-bold"] = "player",
        ["solar:settings-bold"] = "settings",
        ["solar:shield-bold"] = "shield",
        ["search"] = "search", ["settings"] = "settings",
        ["home"] = "home", ["player"] = "player",
        ["sword"] = "sword", ["shield"] = "shield",
        ["eye"] = "eye", ["star"] = "star", ["coin"] = "coin",
        ["heart"] = "heart", ["fire"] = "fire", ["key"] = "key",
        ["warn"] = "warn", ["info"] = "info", ["check"] = "check",
        ["close"] = "close", ["box"] = "box",
    }
    
    local ThemeMap = { Onyx = "Overworld", Dark = "Dark", Light = "Light" }
    
    -- Gradient stub
    function Shim:Gradient(stops, opts) return { Stops = stops, Options = opts } end
    
    -- AddTheme stub
    Shim.Themes = {}
    function Shim:AddTheme(t) Shim.Themes[t.Name or #Shim.Themes + 1] = t end
    
    -- SetTheme
    function Shim:SetTheme(name)
        MarioLib:SetTheme(ThemeMap[name] or "Overworld")
    end
    
    -- ConfigManager shim
    Shim.ConfigManager = { _configs = {} }
    function Shim.ConfigManager:CreateConfig(name)
        local cfg = { Name = name, Elements = {}, _data = {} }
        function cfg:SetAsCurrent() return cfg end
        function cfg:Save() return true end
        function cfg:Load() return true end
        function cfg:Delete() return true end
        function cfg:GetData() return {} end
        self._configs[name] = cfg
        return cfg
    end
    function Shim.ConfigManager:GetConfig(name) return self._configs[name] end
    function Shim.ConfigManager:DeleteConfig(name) self._configs[name] = nil end
    function Shim.ConfigManager:AllConfigs()
        local list = {}
        for k in pairs(self._configs) do list[#list+1] = k end
        return list
    end
    
    -- Notify
    function Shim:Notify(info, content, duration, kind)
        if type(info) == "table" then
            MarioLib:Notify(info.Title, info.Content, info.Duration, info.Icon or "Info")
        else
            MarioLib:Notify(info, content, duration, kind)
        end
    end
    
    -- CreateWindow
    function Shim:CreateWindow(opts)
        opts = opts or {}
        local win = MarioLib:CreateWindow({
            Title = opts.Title or "Onyx",
            SubTitle = opts.Author or "",
            Theme = ThemeMap[opts.Theme] or "Overworld",
            ConfigFolder = opts.Folder or "OnyxV2",
            KeySystem = false,
            Intro = false,
            Watermark = false,
            Layout = "Auto",
        })
        return Shim.WrapWindow(win)
    end
    
    -- Window wrapper
    function Shim.WrapWindow(win)
        local W = { _raw = win, _tabs = {}, Title = win.Title }
        local methods = {}
        
        function methods:Tab(opts)
            opts = opts or {}
            local tab = win:AddTab(opts.Title or "Tab", IconMap[opts.Icon] or opts.Icon or "qblock", opts.Desc or "")
            table.insert(W._tabs, tab)
            return Shim.WrapTab(tab, W)
        end
        function methods:SelectTab(i)
            if type(i) == "number" then
                local t = W._tabs[i]
                if t then win:SelectTab(t._raw or t) end
            else
                win:SelectTab(i._raw or i)
            end
        end
        function methods:Toggle() win:Toggle() end
        function methods:Open() win:Show() end
        function methods:Close() win:Hide() end
        function methods:SetBackgroundTransparency(a) win:SetTransparency(a) end
        function methods:SetBackgroundImageTransparency(_) end
        function methods:OnDestroy(fn) MarioLib:OnUnload(fn) end
        function methods:Tag(_) end
        function methods:EditOpenButton(t)
            if not t or t.Enabled ~= false then MarioLib:SetOverlay("Float", true) end
        end
        function methods:Dialog(o) return MarioLib:Dialog(o) end
        function methods:Popup(a,b,c) return MarioLib:Popup(a,b,c) end
        function methods:SetWatermarkTitle(t) MarioLib:SetWatermarkTitle(t) end
        
        return setmetatable(W, { __index = function(_, k) return methods[k] or win[k] end })
    end
    
    -- Tab wrapper
    function Shim.WrapTab(tab, _)
        local T = { _raw = tab, _default = nil, Name = tab.Name }
        local methods = {}
        
        local function Ensure()
            if not T._default then
                local g = tab:AddLeftGroupbox(" ", nil)
                if g.HeaderBar then g.HeaderBar.Visible = false end
                if g.Seam then g.Seam.Visible = false end
                if g.Patch then g.Patch.Visible = false end
                T._default = g
            end
            return T._default
        end
        
        function methods:Section(opts)
            local ok, err = pcall(function()
                Ensure():AddSeparatorText(opts and opts.Title or "")
            end)
            if not ok then warn("[Shim] Section error:", err) end
            return T
        end
        function methods:Toggle(opts)
            opts = opts or {}
            local idx = opts.Flag or ("t" .. tostring(math.random(1e9)))
            local ok, result = pcall(function()
                return Ensure():AddToggle(idx, {
                    Text = opts.Title, Description = opts.Desc, Default = opts.Value,
                    Callback = opts.Callback, NoSave = opts.Flag == nil,
                })
            end)
            if not ok then warn("[Shim] Toggle error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        -- ... (Slider, Button, Dropdown, Input, Colorpicker, Paragraph, Keybind) sama polanya
        function methods:Slider(opts)
            opts = opts or {}
            local v = opts.Value or {}
            local idx = opts.Flag or ("s" .. tostring(math.random(1e9)))
            local ok, result = pcall(function()
                return Ensure():AddSlider(idx, {
                    Text = opts.Title, Description = opts.Desc,
                    Min = v.Min or 0, Max = v.Max or 100, Default = v.Default or v.Min or 0,
                    Step = opts.Step or 1, Suffix = opts.Suffix,
                    Callback = opts.Callback, NoSave = opts.Flag == nil,
                })
            end)
            if not ok then warn("[Shim] Slider error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        function methods:Button(opts)
            opts = opts or {}
            local ok, result = pcall(function()
                return Ensure():AddButton({
                    Text = opts.Title, Description = opts.Desc,
                    Icon = IconMap[opts.Icon] or opts.Icon, Style = opts.Style or "Default",
                }, opts.Callback)
            end)
            if not ok then warn("[Shim] Button error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        function methods:Dropdown(opts)
            opts = opts or {}
            local idx = opts.Flag or ("d" .. tostring(math.random(1e9)))
            local ok, result = pcall(function()
                return Ensure():AddDropdown(idx, {
                    Text = opts.Title, Description = opts.Desc, Values = opts.Values or {},
                    Multi = opts.Multi, Default = opts.Value,
                    Callback = opts.Callback, NoSave = opts.Flag == nil,
                })
            end)
            if not ok then warn("[Shim] Dropdown error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        function methods:Input(opts)
            opts = opts or {}
            local idx = opts.Flag or ("i" .. tostring(math.random(1e9)))
            local ok, result = pcall(function()
                return Ensure():AddInput(idx, {
                    Text = opts.Title, Description = opts.Desc,
                    Placeholder = opts.Placeholder, Default = opts.Value,
                    Callback = opts.Callback, NoSave = opts.Flag == nil,
                })
            end)
            if not ok then warn("[Shim] Input error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        function methods:Colorpicker(opts)
            opts = opts or {}
            local idx = opts.Flag or ("c" .. tostring(math.random(1e9)))
            local ok, result = pcall(function()
                return Ensure():AddColorPicker(idx, {
                    Text = opts.Title, Description = opts.Desc, Default = opts.Default,
                    Callback = opts.Callback, NoSave = opts.Flag == nil,
                })
            end)
            if not ok then warn("[Shim] Colorpicker error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        function methods:Paragraph(opts)
            opts = opts or {}
            local ok, result = pcall(function()
                return Ensure():AddParagraph({
                    Text = opts.Title, Description = opts.Desc, Icon = IconMap[opts.Icon] or opts.Icon,
                })
            end)
            if not ok then warn("[Shim] Paragraph error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        function methods:Keybind(opts)
            opts = opts or {}
            local idx = opts.Flag or ("k" .. tostring(math.random(1e9)))
            local ok, result = pcall(function()
                return Ensure():AddKeybind(idx, {
                    Text = opts.Title, Description = opts.Desc, Default = opts.Value,
                    ChangedCallback = opts.Callback, NoSave = opts.Flag == nil,
                })
            end)
            if not ok then warn("[Shim] Keybind error:", opts.Title, result) return { _raw = nil } end
            return Shim.WrapWidget(result)
        end
        
        return setmetatable(T, { __index = function(_, k) return methods[k] or tab[k] end })
    end
    
    -- Widget wrapper
    function Shim.WrapWidget(h)
        local H = { _raw = h }
        local methods = {}
        function methods:Set(v) if h and h.SetValue then h:SetValue(v) end end
        function methods:SetValue(v) if h and h.SetValue then h:SetValue(v) end end
        function methods:SetText(t) if h and h.SetText then h:SetText(t) end end
        function methods:SetVisible(v) if h and h.SetVisible then h:SetVisible(v) end end
        function methods:Refresh(v) if h and h.SetValues then h:SetValues(v) end end
        function methods:SetImage(_, _) end
        function methods:Destroy() if h and h.Destroy then h:Destroy() end end
        return setmetatable(H, { __index = function(_, k) return methods[k] or (h and h[k]) end })
    end
    
    return Shim
end
